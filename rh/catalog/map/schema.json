{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RH concept map",
  "type": "object",
  "required": ["claim_boundary", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "claim_boundary": {"type": "string"},
    "generated_at": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/definitions/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/definitions/edge"}
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id", "type", "name", "aliases", "definition", "status",
        "sources", "tags", "attempt_count", "alive"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "type": {
          "enum": [
            "OBJECT", "CRITERION", "THEOREM", "CLASS", "GEOMETRY",
            "TFPT_STRUCTURE", "OPERATOR", "INVARIANT", "METHOD",
            "OPEN_QUESTION", "BARRIER"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "definition": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "CLASSICAL", "PROVED_HERE", "FORMALIZED_LEAN",
            "CONJECTURAL", "KILLED_HERE", "OPEN"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "attempt_count": {"type": "integer", "minimum": 0},
        "alive": {"type": "boolean"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["src", "dst", "rel", "strength", "source", "note"],
      "additionalProperties": false,
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "dst": {"type": "string", "minLength": 1},
        "rel": {
          "enum": [
            "EQUIVALENT_TO", "IMPLIES", "IMPLIED_BY", "REDUCES_TO",
            "SPECIAL_CASE_OF", "GENERALIZES", "INSTANCE_OF", "REALIZES",
            "TRANSFORM_OF", "DUAL_TO", "REQUIRES", "WOULD_CLOSE",
            "BLOCKED_BY", "USED_BY", "KILLED_BY", "CO_OCCURS"
          ]
        },
        "strength": {
          "enum": ["THEOREM", "CONDITIONAL", "HEURISTIC", "STATISTICAL"]
        },
        "source": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "weight": {"type": "integer", "minimum": 1}
      }
    }
  }
}
