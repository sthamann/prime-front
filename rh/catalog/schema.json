{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rh/catalog/schema.json",
  "title": "RH semantic catalog record",
  "description": "One record per INVENTORY path or working-tree path. Catalog file wrappers are not this schema. NO RH CLAIM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "round",
    "role",
    "ledger_ids",
    "status_raw",
    "kind",
    "family",
    "family_secondary",
    "question",
    "mechanism",
    "result_verdict",
    "outcome",
    "solved",
    "failed_because",
    "failure_class",
    "rh_relevance",
    "artifacts",
    "reusable",
    "depends_on",
    "readme_lines",
    "confidence"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "INVENTORY path or working-tree path"
    },
    "round": {
      "type": "string",
      "description": "Round id or range (e.g. r645, r224-r226)"
    },
    "role": {
      "type": "string",
      "description": "INVENTORY role (verification_module, sealed_probe, ...)"
    },
    "ledger_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status_raw": {
      "type": "string",
      "description": "INVENTORY status string, copied verbatim"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ATTACK",
        "REDUCTION",
        "FOUNDATION",
        "CERTIFICATE",
        "CONTROL",
        "FORMALIZATION",
        "EXTERNAL_AUDIT",
        "DOCUMENTATION",
        "TOOLING",
        "OTHER"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "WEIL_POSITIVITY_WINDOWS",
        "SCREW_SUBORDINATION_LSTAR",
        "LEAN_FORMALIZATION",
        "EXPLICIT_FORMULA_IDENTITY",
        "OPERATOR_SPECTRAL",
        "RHP_IIKS_TAU",
        "TOEPLITZ_MOMENT_POSITIVITY",
        "MELLIN_PICK_LEE_YANG",
        "LATTICE_E8_HECKE",
        "ADELIC_GROUPOID_CONNES",
        "ARAKELOV_HODGE_INTERSECTION",
        "CM_CURVE_GEOMETRY",
        "DYNAMICS_CLOCKS_PF",
        "SELBERG_TRACE_CONTACT",
        "PRIME_EVENT_LOG_DECODING",
        "SIEVE_FACTORING_GEOMETRY",
        "CERTIFICATE_INFRASTRUCTURE",
        "EXTERNAL_ADJUDICATION",
        "OTHER"
      ]
    },
    "family_secondary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "WEIL_POSITIVITY_WINDOWS",
          "SCREW_SUBORDINATION_LSTAR",
          "LEAN_FORMALIZATION",
          "EXPLICIT_FORMULA_IDENTITY",
          "OPERATOR_SPECTRAL",
          "RHP_IIKS_TAU",
          "TOEPLITZ_MOMENT_POSITIVITY",
          "MELLIN_PICK_LEE_YANG",
          "LATTICE_E8_HECKE",
          "ADELIC_GROUPOID_CONNES",
          "ARAKELOV_HODGE_INTERSECTION",
          "CM_CURVE_GEOMETRY",
          "DYNAMICS_CLOCKS_PF",
          "SELBERG_TRACE_CONTACT",
          "PRIME_EVENT_LOG_DECODING",
          "SIEVE_FACTORING_GEOMETRY",
          "CERTIFICATE_INFRASTRUCTURE",
          "EXTERNAL_ADJUDICATION",
          "OTHER"
        ]
      }
    },
    "question": {
      "type": "string",
      "description": "What was asked; ≤30 words (enforced by build_catalog.py)"
    },
    "mechanism": {
      "type": "string",
      "description": "How it was attacked; ≤30 words (enforced by build_catalog.py)"
    },
    "result_verdict": {
      "type": "string",
      "description": "Literal verdict string(s) from the artefact"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PROVED",
        "CERTIFIED",
        "MEASURED",
        "KILLED",
        "INCONCLUSIVE",
        "OPEN",
        "RESTATED",
        "SEALED"
      ]
    },
    "solved": {
      "type": "string",
      "description": "What closed, with [E]/[C] level; ≤40 words"
    },
    "failed_because": {
      "type": "string",
      "description": "Why it died, or empty; ≤40 words"
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "CIRCULAR",
        "WORLD_BLIND",
        "LOSSY_CONSTANT",
        "STRUCTURAL_MISMATCH",
        "NUMERIC_ARTIFACT",
        "ORACLE_LEAK",
        "RESTATEMENT",
        "NO_BRIDGE",
        "UNCONVERGED",
        "NOT_APPLICABLE"
      ]
    },
    "rh_relevance": {
      "type": "string",
      "enum": [
        "LOAD_BEARING_OPEN",
        "EQUIVALENCE",
        "FINITE_FRAGMENT",
        "IDENTITY_SIDE",
        "INFRASTRUCTURE",
        "UNRELATED"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "result_json", "tex", "lean", "figures"],
      "properties": {
        "probe": { "type": ["string", "null"] },
        "result_json": { "type": ["string", "null"] },
        "tex": { "type": ["string", "null"] },
        "lean": { "type": "array", "items": { "type": "string" } },
        "figures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reusable": {
      "type": "string",
      "description": "Reusable asset note; ≤30 words or empty"
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Round ids or paths this record depends on"
    },
    "readme_lines": {
      "type": "string",
      "pattern": "^$|^[0-9]+-[0-9]+$",
      "description": "Inclusive rh/README.md line window 'a-b', or empty"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "med", "high"]
    },
    "needs_review": {
      "type": "boolean",
      "description": "true when the record is an INVENTORY stub or auto-draft"
    },
    "draft": {
      "type": "boolean",
      "description": "true when the record was produced by autodraft.py and is not yet curated"
    },
    "rh_related_evidence": {
      "type": "string",
      "description": "Matched RH-context token or path:rh/ / inventory that justified inclusion"
    },
    "inventory_sha256": {
      "type": ["string", "null"],
      "description": "SHA-256 copied from INVENTORY.json at build time (pinned-path drift detector)"
    },
    "llm_model": {
      "type": "string",
      "description": "Chat model used by autodraft --llm; empty when unused"
    },
    "llm_rationale": {
      "type": "string",
      "description": "LLM rationale, at most 40 words; empty when unused"
    },
    "reconciled": {
      "type": "boolean",
      "description": "true when a T5 outcome split is annotated; history outcomes are not rewritten"
    },
    "superseded_by": {
      "type": "string",
      "description": "Canonical path (or round) that carries the current statement"
    },
    "reconciliation_note": {
      "type": "string",
      "description": "Why outcomes differ: IDENTITY_VS_ROUTE, follow-up reuse, companion grade, or contradiction"
    }
  }
}
